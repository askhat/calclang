# Юниты
unit usd base currency
unit kzt (usd / 467,245543)
unit rub (usd / 90,5)

unit kg base mass
unit gr (kg / 1_000)

unit m base length
unit s base time

# Переменные
-10 minusTen                                      // = -10
35,5 rub salary                                   // = 35,5 rub
2 kg flour                                        // = 2 kg

# Выражения с присваиванием
salary + minusTen = total       # total = 25,5 rub  // = 25,5 rub
salary as kzt = salaryInKzt     # конверсия       // = 183,284163 kzt
100 rub + 5 usd                 # = 15 usd (правый юнит побеждает, рубли сконвертируются в доллары)  // = 6,104972 usd

#10 !- 10
