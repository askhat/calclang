# Юниты
unit usd base currency
unit kzt (usd / 467,245543)
unit rub (usd / 90,5)

unit kg base mass
unit gr (kg / 1_000)

unit m base length
unit s base time

# Переменные
-10 minusTen
35,5 rub salary
2 kg flour

# Выражения с присваиванием
salary + minusTen = total       # total = 25,5 rub
salary as kzt = salaryInKzt     # конверсия
100 rub + 5 usd                 # = 15 usd (правый юнит побеждает, рубли сконвертируются в доллары)

#10 !- 10
