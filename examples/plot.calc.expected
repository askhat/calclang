# PLOT — drawing primitives + auto-charts.
# Coords are dimensionless Decimals; vars work; turtle flattens into LINEs.

# ── Geometric primitives ──────────────────────────────────────────────
PLOT shapes                                       // = plot (4 shapes)
LINE 0 0 100 100
RECT 10 10 30 20
CIRCLE 60 60 15
POINT 80 30

# ── Variables in args ────────────────────────────────────────────────
# PLOT args are strict primaries — wrap arithmetic in parens.
10 cx                                             // = 10
20 r                                              // = 20
PLOT vars                                         // = plot (3 shapes)
CIRCLE cx cx r
CIRCLE (cx + 30) cx r
CIRCLE (cx + 60) cx r

# ── Turtle: square via F + R ─────────────────────────────────────────
PLOT square                                       // = plot (4 shapes)
F 50
R 90
F 50
R 90
F 50
R 90
F 50

# ── Turtle: L is the inverse of R ────────────────────────────────────
PLOT mirror                                       // = plot (2 shapes)
F 30
L 90
F 30

# ── Turtle: MOVE / pen UP/DOWN for multi-stroke drawings ─────────────
PLOT dashed                                       // = plot (3 shapes)
F 10
U
F 10
D
F 10
M 50 0
F 20

# ── Explicit viewport via SIZE ───────────────────────────────────────
PLOT framed                                       // = plot (2 shapes)
SIZE 100 100
RECT 0 0 100 100
CIRCLE 50 50 20

# ── Text labels ──────────────────────────────────────────────────────
PLOT labeled                                      // = plot (2 shapes)
LINE 0 0 100 0
TEXT 50 -10 "axis"

# ── Empty plot (zero shapes) ─────────────────────────────────────────
PLOT empty                                        // = plot (0 shapes)

# ── Auto-chart from a series ─────────────────────────────────────────
SERIES prices
100                                               // = 100
120                                               // = 120
105                                               // = 105
140                                               // = 140
115                                               // = 115
160                                               // = 160

PLOT chart prices                                 // = plot (5 shapes)

# ── Auto-chart from a range ──────────────────────────────────────────
RANGE r10 1 10
PLOT diag r10                                     // = plot (9 shapes)

# ── Singleton series degenerates to a point ──────────────────────────
SERIES one
42                                                // = 42

PLOT solo one                                     // = plot (1 shape)

# ── Multi-series overlay (palette colors per layer) ──────────────────
SERIES revenue
100                                               // = 100
120                                               // = 120
105                                               // = 105
140                                               // = 140

SERIES cost
80                                                // = 80
90                                                // = 90
85                                                // = 85
100                                               // = 100

PLOT compare revenue cost                         // = plot (6 shapes)
