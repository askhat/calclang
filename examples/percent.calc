# Проценты — литерал N% и оператор `of`.
# Правила:
#   • `Quantity ± Percent` → Soulver-стиль: «масштабировать левый на 1±p».
#   • `Percent ± Percent`  → процент (просто сложение/вычитание долей).
#   • `Percent op Percent` (mul/of/div) → процент или доля (см. примеры).
#   • Всё остальное приводит процент к безразмерной дроби.

20%                              # bare percent — 0,20 в долях
(1 + 2)%                         # postfix `%` на скобках
12,5%                            # дробный процент

# ─── Sales tax / VAT ─────────────────────────────────────────────────
UNIT Currency usd
1_000 usd subtotal
subtotal + 20% = withVat         # цена с НДС 20%
withVat - subtotal               # сам налог

# ─── Скидка ──────────────────────────────────────────────────────────
2_000 price
price - 30%                      # после скидки 30%

# ─── Доли и комбинации ───────────────────────────────────────────────
20% of 1000                      # 200 — процент от значения
20% of 500 usd                   # 100 usd
20% + 30%                        # 50% (оба процента → процент)
50% - 10%                        # 40%
20% of 50%                       # 10% (доля доли)
20% / 50%                        # 0,4 — отношение процентов, чистое число

# Negative
-15%                             # минус 15% сохраняет процент

# ─── Аннуитет: ставка как процент в формуле ──────────────────────────
# В формуле проценты приводятся к доле автоматически.
5 rate                           # 5% годовых
(1 + rate%)^3                    # коэффициент сложных процентов за 3 года

# ─── Реальный сценарий: чаевые ───────────────────────────────────────
1_250 bill
bill + 18% = withTip             # чаевые 18%
withTip - bill                   # сами чаевые
