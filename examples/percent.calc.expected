# Проценты — литерал N% и оператор `of`.
# Правила:
#   • `Quantity ± Percent` → Soulver-стиль: «масштабировать левый на 1±p».
#   • `Percent ± Percent`  → процент (просто сложение/вычитание долей).
#   • `Percent op Percent` (mul/of/div) → процент или доля (см. примеры).
#   • Всё остальное приводит процент к безразмерной дроби.

20%                              # bare percent — 0,20 в долях  // = 20%
(1 + 2)%                         # postfix `%` на скобках  // = 3%
12,5%                            # дробный процент  // = 12,5%

# ─── Sales tax / VAT ─────────────────────────────────────────────────
UNIT Currency usd
1_000 usd subtotal                                // = 1 000 usd
subtotal + 20% = withVat         # цена с НДС 20% // = 1 200 usd
withVat - subtotal               # сам налог      // = 200 usd

# ─── Скидка ──────────────────────────────────────────────────────────
2_000 price                                       // = 2 000
price - 30%                      # после скидки 30%  // = 1 400

# ─── Доли и комбинации ───────────────────────────────────────────────
20% of 1000                      # 200 — процент от значения  // = 200
20% of 500 usd                   # 100 usd        // = 100 usd
20% + 30%                        # 50% (оба процента → процент)  // = 50%
50% - 10%                        # 40%            // = 40%
20% of 50%                       # 10% (доля доли)  // = 10%
20% / 50%                        # 0,4 — отношение процентов, чистое число  // = 0,4

# Negative
-15%                             # минус 15% сохраняет процент  // = -15%

# ─── Аннуитет: ставка как процент в формуле ──────────────────────────
# В формуле проценты приводятся к доле автоматически.
5 rate                           # 5% годовых     // = 5
(1 + rate%)^3                    # коэффициент сложных процентов за 3 года  // = 1,157625

# ─── Реальный сценарий: чаевые ───────────────────────────────────────
1_250 bill                                        // = 1 250
bill + 18% = withTip             # чаевые 18%     // = 1 475
withTip - bill                   # сами чаевые    // = 225
