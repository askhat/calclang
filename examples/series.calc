# SERIES — собираем числа в группу и применяем агрегаты

SERIES foo
100
20
222
500
-3909
0

foo.count
foo.sum
foo.avg
foo.min
foo.max

# Серии работают с юнитами тоже — пока все члены одной размерности.
# «Юнит серии» = юнит последнего члена с явным юнитом;
# агрегаты возвращают значение в этом юните.

UNIT Currency usd
UNIT (usd / 90,5) rub

SERIES wallet
100 rub
5 usd
2000 rub
50 usd

wallet.sum
wallet.avg

# Именованные члены: <число> [<юнит>] <имя>. Доступ — через точку.
# Безюнитные члены автоматически промотируются в юнит серии.

SERIES budget
500 usd salary
400 bonus
-100 rub tax

budget.salary
budget.bonus
budget.tax
budget.sum
