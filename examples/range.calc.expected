# RANGE — итерируемая коллекция чисел с монотонным шагом 1.
# Два литерала: `..` — inclusive (включает end), `...` — exclusive.

# ─── Базовые литералы ───────────────────────────────────────────────────

1..10 onesToTen
onesToTen.count                                   // = 10
onesToTen.sum                                     // = 55
onesToTen.avg                                     // = 5,5
onesToTen.min                                     // = 1
onesToTen.max                                     // = 10

# Exclusive: 1, 2, ..., 9 — 9 членов, без 10
1...10 exclusive
exclusive.sum                                     // = 45
exclusive.count                                   // = 9

# Bare литерал без имени — печатает себя со счётчиком
1..5                                              // = 1..5 (n=5)
1...5                                             // = 1...5 (n=4)

# ─── Десятичные границы и обратный порядок ──────────────────────────────

# Шаг всё ещё 1, так что 1,5 → 2,5 → 3,5 → 4,5 → 5,5
1,5..5,5 decimals
decimals.sum                                      // = 17,5
decimals.avg                                      // = 3,5

# start > end → идём вниз: 10, 9, 8, ..., 1
10..1 down
down.sum                                          // = 55
down.count                                        // = 10

# ─── Keyword-форма (inclusive only) ─────────────────────────────────────

RANGE keyword 1 100
keyword.count                                     // = 100
keyword.sum                                       // = 5 050

# Endpoints могут быть выражениями
RANGE squared (2 ^ 1) (2 ^ 4)
squared.sum                                       // = 135

# ─── Юниты ──────────────────────────────────────────────────────────────

UNIT Currency usd
UNIT (usd / 90,5) rub

# Оба endpoint в одной валюте — простой случай
1 usd..10 usd wallet
wallet.sum                                        // = 55 usd
wallet.avg                                        // = 5,5 usd

# Один endpoint без юнита — промоутится в юнит другого (как у SERIES)
1..5 usd promoted
promoted.sum                                      // = 15 usd

# Разные юниты, одна dim — последний явный (end) задаёт юнит rangeа,
# start конвертируется. 100 rub ≈ 1,105 usd → членов: 1,105; 2,105; 3,105; 4,105.
100 rub..5 usd mixed
mixed.count                                       // = 4
mixed.sum                                         // = 10,41989 usd

# ─── Inline aggregates на скобках ───────────────────────────────────────

(1..100).sum                                      // = 5 050
(1..100).avg                                      // = 50,5

# Range можно сослаться по имени и подмешать в выражение
onesToTen.sum + onesToTen.count                   // = 65
