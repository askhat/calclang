# RANGE — итерируемая коллекция чисел с монотонным шагом 1.
# Два литерала: `..` — inclusive (включает end), `...` — exclusive.

# ─── Базовые литералы ───────────────────────────────────────────────────

1..10 onesToTen
onesToTen.count                                   // = 10
onesToTen.sum                                     // = 55
onesToTen.avg                                     // = 5,5
onesToTen.min                                     // = 1
onesToTen.max                                     // = 10

# Exclusive: 1, 2, ..., 9 — 9 членов, без 10
1...10 exclusive
exclusive.sum                                     // = 45
exclusive.count                                   // = 9

# Bare литерал без имени — печатает себя со счётчиком
1..5                                              // = 1..5 (n=5)
1...5                                             // = 1...5 (n=4)

# ─── Десятичные границы и обратный порядок ──────────────────────────────

# Snap-to-multiples: 1,5 — якорь, потом целые кратные 1 в (1,5; 5,5] = 2..5
1,5..5,5 decimals
decimals.sum                                      // = 15,5
decimals.avg                                      // = 3,1

# start > end → идём вниз: 10, 9, 8, ..., 1
10..1 down
down.sum                                          // = 55
down.count                                        // = 10

# ─── Кастомный шаг `/step` ──────────────────────────────────────────────
# Семантика: start всегда якорь, потом кратные step в (start, end].
# Для exclusive: start включается только если есть хоть один шаг внутри.

1..10/1 byOne
byOne.count                                       // = 10

1..10/3 byThree
byThree.sum                # 1 + 3 + 6 + 9 = 19   // = 19
byThree.count                                     // = 4

1..10/5 byFive
byFive.sum                 # 1 + 5 + 10 = 16      // = 16
byFive.count                                      // = 3

# Шаг больше предела
1..10/100 huge
huge.count                 # только start: 1      // = 1

1...10/100 hugeExcl
hugeExcl.count             # exclusive + нет шагов внутри → пусто  // = 0

# ─── Keyword-форма (inclusive only) ─────────────────────────────────────

RANGE keyword 1 100
keyword.count                                     // = 100
keyword.sum                                       // = 5 050

# Endpoints могут быть выражениями
RANGE squared (2 ^ 1) (2 ^ 4)
squared.sum                                       // = 135

# ─── Юниты ──────────────────────────────────────────────────────────────

UNIT Currency usd
UNIT (usd / 90,5) rub

# Оба endpoint в одной валюте — простой случай
1 usd..10 usd wallet
wallet.sum                                        // = 55 usd
wallet.avg                                        // = 5,5 usd

# Один endpoint без юнита — промоутится в юнит другого (как у SERIES)
1..5 usd promoted
promoted.sum                                      // = 15 usd

# Разные юниты, одна dim — последний явный (end) задаёт юнит range'а,
# start конвертируется. 100 rub ≈ 1,105 usd. Snap step=1: anchor 1,105
# плюс целые кратные 1 в (1,105; 5] = 2, 3, 4, 5.
100 rub..5 usd mixed
mixed.count                                       // = 5
mixed.sum                                         // = 15,104972 usd

# ─── Inline aggregates на скобках ───────────────────────────────────────

(1..100).sum                                      // = 5 050
(1..100).avg                                      // = 50,5

# Range можно сослаться по имени и подмешать в выражение
onesToTen.sum + onesToTen.count                   // = 65
