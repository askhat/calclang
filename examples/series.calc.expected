# SERIES — собираем числа в группу и применяем агрегаты

SERIES foo
100                                               // = 100
20                                                // = 20
222                                               // = 222
500                                               // = 500
-3909                                             // = -3 909
0                                                 // = 0

foo.count                                         // = 6
foo.sum                                           // = -3 067
foo.avg                                           // = -511,166667
foo.min                                           // = -3 909
foo.max                                           // = 500

# Серии работают с юнитами тоже — пока все члены одной размерности.
# «Юнит серии» = юнит последнего члена с явным юнитом;
# агрегаты возвращают значение в этом юните.

UNIT Currency usd
UNIT (usd / 90,5) rub

SERIES wallet
100 rub                                           // = 100 rub
5 usd                                             // = 5 usd
2000 rub                                          // = 2 000 rub
50 usd                                            // = 50 usd

wallet.sum                                        // = 78,20442 usd
wallet.avg                                        // = 19,551105 usd

# Именованные члены: <число> [<юнит>] <имя>. Доступ — через точку.
# Безюнитные члены автоматически промотируются в юнит серии.

SERIES budget
500 usd salary                                    // = 500 usd
400 bonus                                         // = 400 rub
-100 rub tax                                      // = -100 rub

budget.salary                                     // = 500 usd
budget.bonus                                      // = 400 rub
budget.tax                                        // = -100 rub
budget.sum                                        // = 45 550 rub
